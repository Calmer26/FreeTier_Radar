GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=   # a free-tier key, so the test shows which Gemini models are free
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=   # Cloudflare → My Profile → API Tokens → "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=  # the code after dash.cloudflare.com/ in the dashboard URL
ZAI_API_KEY=   # z.ai → API keys; free GLM Flash models
SITE_URL=https://freetierradar.com
