---
import "../styles/global.css";
import { SITE } from "../../site.config";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** schema.org structured data for this page (one object or several). */
  jsonLd?: object | object[];
}

const { title, description = SITE.tagline, noindex = false, jsonLd } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ["/", "Directory"],
  ["/changes/", "Changes"],
  ["/roundups/", "Roundups"],
  ["/rankings/", "Rankings"],
  ["/cline/", "Cline"],
  ["/offers/", "Free credits"],
  ["/providers/", "Providers"],
  ["/methodology/", "Methodology"],
  ["/settings/", "Settings"],
];
const fullTitle = path === "/" ? `${SITE.name}: free AI models that actually work` : `${title} · ${SITE.name}`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
// Every page says what site it belongs to; the home page also describes the site itself.
const structured = [
  ...(path === "/"
    ? [{ "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: new URL("/", Astro.site).href, description: SITE.tagline }]
    : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} changes`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {structured.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {/* Visit counts: Cloudflare Web Analytics, cookieless. Production builds only, so local runs aren't counted. */}
    {import.meta.env.PROD && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "91ed2ffe2f9f44afaaa11052e2d760a8"}'></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/"><span class="logo-dot"></span>{SITE.name}</a>
        <nav class="nav">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Data is checked every 6 hours; each free model gets one test request per day.</span>
        <span>
          <a href="/rss.xml">RSS</a> · <a href="/developers/">Working-models feed</a> · <a href="/free/">Where each model is free</a> ·
          <a href={SITE.repo}>Data on GitHub</a> ·
          <a href={`${SITE.repo}/issues/new?template=suggest-resource.yml`}>Suggest a resource</a> ·
          <a href="/sponsor/">Sponsor</a>
        </span>
      </div>
    </footer>
  </body>
</html>
