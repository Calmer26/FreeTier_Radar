---
import Base from "../../layouts/Base.astro";
import Badges from "../../components/Badges.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import { activeModels, type ModelView } from "../../lib/data";
import { MIN_TESTED_DAYS, rank, RANKINGS, RANKING_WINDOW_DAYS, type RankingDef } from "../../../pipeline/rankings";
import { toolStats } from "../../../pipeline/agent-ready";
import { ARENA_ATTRIBUTION, ARENA_DATASET_URL } from "../../../pipeline/arena";
import { PROVIDERS } from "../../../pipeline/providers";
import { formatContext } from "../../../pipeline/templates";

export function getStaticPaths() {
  return RANKINGS.map((def) => ({ params: { slug: def.slug }, props: { def } }));
}

const { def } = Astro.props as { def: RankingDef };
const list = rank(def, activeModels.map((m) => ({ r: m, history: m.tests, tools: m.toolTests, arena: m.arena })));
const isChat = !["text-to-speech", "speech-to-text"].includes(def.slug);
const isCoding = def.slug.startsWith("coding");
const arenaBoard = isCoding ? "webdev" : def.slug === "vision" ? "vision" : "text";
const showArena = isChat && list.some((x) => x.arena);
const arenaCell = (m: ModelView) => {
  const b = m.arena?.boards[arenaBoard] ?? (arenaBoard === "webdev" ? m.arena?.boards.text : undefined);
  return b?.rating ? Math.round(b.rating) : "–";
};
const pct = (s: number | null) => (s == null ? "–" : `${Math.round(s * 100)}%`);
---
<Base
  title={def.title}
  description={`${def.intro} Ranked by daily tests; updated every day.`}
  noindex={list.length === 0}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: def.title,
    itemListElement: list.slice(0, 10).map((x, i) => ({ "@type": "ListItem", position: i + 1, name: x.r.name, url: new URL((x.r as ModelView).href, Astro.site).href })),
  }}
>
  <p class="sub"><a href="/rankings/">Rankings</a></p>
  <h1>{def.title}</h1>
  <p class="lede">{def.intro}</p>
  {def.slug === "image-generation" && <p class="callout info">See every model's sample outputs for the same prompts on <a href="/image-models/">Free image models compared</a>.</p>}
  <p class="sub"><strong>Order:</strong> {def.order} Reliability counts days a model answered out of the days it was tested (rate-limited days don't count), over the last {RANKING_WINDOW_DAYS} days.</p>
  {isCoding && <p class="callout info">Using Cline? The <a href="/cline/">Cline setup page</a> suggests the best free Plan + Act pair, with settings to paste.</p>}
  <SponsorSlot />
  {list.length === 0 ? (
    <p class="sub">Not enough test data yet. Most rankings need at least {MIN_TESTED_DAYS} days of daily tests.</p>
  ) : (
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>#</th><th>Model</th><th>Provider</th>
            {isChat && <th class="num">Context</th>}
            {showArena && <th class="num" title={`LMArena ${arenaBoard === "webdev" ? "WebDev (or Text)" : arenaBoard === "vision" ? "Vision" : "Text"} rating`}>Arena</th>}
            {isCoding && <th class="num" title="Days it passed our tool-call test, last 30 days">Tool calls</th>}
            <th class="num">Answered</th><th class="num hide-sm">Median time</th><th class="hide-sm">Labels</th>
          </tr>
        </thead>
        <tbody>
          {list.map((x, i) => {
            const m = x.r as ModelView;
            return (
              <tr>
                <td class="num">{i + 1}</td>
                <td><a class="model-name" href={m.href}>{m.name}</a><div class="sub mono">{m.model_id}</div></td>
                <td>{PROVIDERS[m.provider].label.split(" (")[0]}</td>
                {isChat && <td class="num">{formatContext(m.context_length)}</td>}
                {showArena && <td class="num">{arenaCell(m)}</td>}
                {isCoding && (() => { const t = toolStats(m.toolTests, RANKING_WINDOW_DAYS); return <td class="num">{t.tested ? `${t.passed}/${t.tested}` : "–"}</td>; })()}
                <td class="num">{pct(x.rel.share)} <span class="sub">({x.rel.responded}/{x.rel.tested} days)</span></td>
                <td class="num hide-sm">{x.rel.medianLatencyMs == null ? "–" : `${(x.rel.medianLatencyMs / 1000).toFixed(1)} s`}</td>
                <td class="hide-sm"><Badges m={m} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
  {showArena && (
    <p class="sub">Arena ratings: <a href={ARENA_DATASET_URL} rel="noopener">{ARENA_ATTRIBUTION}</a>. A dash means the model has no rating there yet.</p>
  )}
</Base>
