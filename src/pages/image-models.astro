---
import Base from "../layouts/Base.astro";
import SponsorSlot from "../components/SponsorSlot.astro";
import { activeModels, formatDate, showcase } from "../lib/data";
import { formatNeurons, formatUsd, freePerDay, imageCost } from "../../pipeline/cloudflare-pricing";
import { showcaseKey, SHOWCASE_PROMPTS } from "../../pipeline/showcase";

// Best-rated first, then cheaper: the same order as the image ranking.
const models = activeModels
  .filter((m) => m.kind === "image")
  .map((m) => ({ m, cost: m.pricing ? imageCost(m.pricing) : null, rating: m.arena?.boards.text_to_image?.rating ?? null }))
  .sort((a, b) => (b.rating ?? -1) - (a.rating ?? -1) || (a.cost?.neurons ?? 1e9) - (b.cost?.neurons ?? 1e9));
const done = Object.keys(showcase.images).length;
const total = models.length * SHOWCASE_PROMPTS.length;
---
<Base title="Free image models compared" description="Every free AI image generation model draws the same three test pictures: text on a sign, hands, and a precise layout. Side by side, with cost in Neurons and LMArena ratings.">
  <h1>Free image models compared</h1>
  <p class="lede">
    Every free image model draws the same three test pictures, each aimed at a common weakness: text, hands, and following
    precise instructions. Side by side with what each image costs and how it rates on LMArena. More expensive is not always better.
  </p>
  <p class="sub">
    {done} of {total} samples made so far; new ones are added each day within a small share of the free allowance.
    Samples are generated by us at each model's default settings through Cloudflare Workers AI, shown for comparison only.
    Check a model's licence (on its page) before using its images commercially.
  </p>
  <SponsorSlot />

  {SHOWCASE_PROMPTS.map((p) => (
    <>
      <h2 id={p.id}>{p.title}</h2>
      <p class="sub"><strong>Prompt:</strong> “{p.prompt}”</p>
      <p class="sub"><strong>Look for:</strong> {p.look_for}</p>
      <div class="offers">
        {models.map(({ m, cost, rating }) => {
          const img = showcase.images[showcaseKey(m.id, p.id)];
          const free = freePerDay(cost);
          return (
            <article class="offer sample">
              {img ? (
                <a href={img.file}><img src={img.file} alt={`${m.name}: ${p.title}`} loading="lazy" width="768" height="768" /></a>
              ) : (
                <div class="pending">Not made yet</div>
              )}
              <h3><a href={m.href}>{m.name.split("/").pop()}</a></h3>
              <p class="sub">
                {rating ? <>Arena <strong>{Math.round(rating)}</strong> · </> : <>No Arena rating · </>}
                {cost ? (cost.neurons ? <>{formatNeurons(cost.neurons)} · {formatUsd(cost.usd)}{free != null && free !== Infinity ? ` · ${free} free/day` : ""}</> : "$0 listed (beta)") : "price unknown"}
              </p>
              {img && <p class="sub">Made {formatDate(img.generated_on)}</p>}
            </article>
          );
        })}
      </div>
    </>
  ))}
</Base>
