---
import Base from "../../../layouts/Base.astro";
import Badges from "../../../components/Badges.astro";
import EventList from "../../../components/EventList.astro";
import SponsorSlot from "../../../components/SponsorSlot.astro";
import TestStatus from "../../../components/TestStatus.astro";
import { events, formatDate, formatTime, modelById, models, showcase, type ModelView } from "../../../lib/data";
import { showcaseKey, SHOWCASE_PROMPTS } from "../../../../pipeline/showcase";
import { PROVIDERS } from "../../../../pipeline/providers";
import { formatContext, formatLimits, KIND_LABELS } from "../../../../pipeline/templates";
import { clineFit, clineSnippet } from "../../../lib/cline";
import { toolStats } from "../../../../pipeline/agent-ready";
import { RANKING_WINDOW_DAYS } from "../../../../pipeline/rankings";
import { allowanceNote, costNote, formatUsd } from "../../../../pipeline/cloudflare-pricing";
import { ARENA_ATTRIBUTION, ARENA_BOARD_LABELS, ARENA_BOARDS, ARENA_DATASET_URL } from "../../../../pipeline/arena";

export function getStaticPaths() {
  return models.map((m) => ({ params: { provider: m.provider, slug: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: ModelView };
const provider = PROVIDERS[m.provider];
const history = events.filter((e) => e.resource_id === m.id);
const yn = (v: boolean | null) => (v === true ? "Yes" : v === false ? "No" : "Unknown");
const runBase = provider.base_url.replace(/\/v1$/, "");
const apiSnippet = m.provider === "cloudflare" && m.kind !== "chat"
  ? `POST ${runBase}/run/${m.model_id}\nAuthorization: Bearer <your Workers AI token>\n${m.kind === "image" ? (m.model_id.includes("flux-2") ? "multipart form: prompt=…, width=1024, height=1024" : '{ "prompt": "a red apple on a white table" }') : m.kind === "tts" ? '{ "prompt": "Hello!" }' : "body: the audio file"}`
  : m.kind === "tts"
  ? `POST ${provider.base_url}/audio/speech\n{ "model": "${m.model_id}", "input": "Hello!" }`
  : m.kind === "stt"
    ? `POST ${provider.base_url}/audio/transcriptions  (multipart)\nfile=@clip.mp3  model=${m.model_id}`
    : "";
const geminiSpeech = m.kind !== "chat" && m.provider === "google-ai-studio";
const snippet = m.kind === "chat" ? clineSnippet(m) : "";
const siblings = m.siblings.map((id) => modelById.get(id)!).filter(Boolean);
const fit = clineFit(m.id);
const tt = toolStats(m.toolTests, RANKING_WINDOW_DAYS);
// Search-friendly title and description: "Qwen3.8 27B free on OpenRouter" plus the key facts.
const cleanName = m.name.replace(/\s*\(free\)\s*/i, " ").replace(/^[^:]+:\s*/, "").trim() || m.name;
const providerShort = provider.label.split(" (")[0];
const pageTitle = `${cleanName} ${m.kind === "chat" ? "" : `(${KIND_LABELS[m.kind].toLowerCase()}) `}free on ${providerShort}`;
const rel = m.tests.length ? `${m.tests.filter((t) => t.status === "responded").length} of ${m.tests.length} daily tests answered` : "not tested yet";
const facts = [
  m.kind === "chat" && m.context_length ? `${formatContext(m.context_length)} context` : null,
  m.kind === "chat" && (m.tool_calling || m.toolTests.some((t) => t.status === "pass")) ? "tool calling" : null,
  m.usage_terms === "evaluation-only" ? "evaluation only" : null,
  m.testable ? rel : "only inside Cline",
].filter(Boolean).join(", ");
const description = `Is ${cleanName} free on ${providerShort}? ${facts}. Limits, cost, ${m.kind === "chat" ? "Cline settings" : "how to call it"} and change history, updated daily.`;
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Providers", item: new URL("/providers/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: provider.label, item: new URL(`/providers/${m.provider}/`, Astro.site).href },
    { "@type": "ListItem", position: 3, name: cleanName, item: new URL(m.href, Astro.site).href },
  ],
};
---
<Base title={pageTitle} description={description} noindex={!m.indexable || m.unreachable} jsonLd={breadcrumbs}>
  <p class="sub"><a href={`/providers/${m.provider}/`}>{provider.label}</a> · {KIND_LABELS[m.kind]}</p>
  <h1>{m.name}</h1>
  <p class="mono sub">{m.model_id}</p>
  <p><Badges m={m} /></p>

  {m.unreachable && (
    <p class="callout"><strong>Listed but not callable.</strong> {provider.label} lists this model, but our daily test got "not found" on each of the last 3 days. It's left out of the directory until it answers again.</p>
  )}
  {m.listed_by === "curated" && (
    <p class="callout info"><strong>Hand-listed.</strong> {provider.label} doesn't publish a list of these models, so we keep this entry by hand. The daily test shows whether it still works.</p>
  )}
  {m.usage_terms === "evaluation-only" && (
    <p class="callout"><strong>Evaluation only.</strong> {provider.usage_terms_note}</p>
  )}
  {m.agent.caveat && <p class="callout"><strong>Rate limits for agents:</strong> {m.agent.caveat}</p>}

  <dl class="facts">
    <div><dt>Price</dt><dd>{m.price_type === "free" ? "$0" : m.price_type === "freemium-quota" ? "$0 within free quota" : "Free tier not confirmed by listing"}</dd></div>
    {m.kind === "chat" && <div><dt>Context window</dt><dd>{formatContext(m.context_length)}{m.context_from && <span class="sub" title="This provider doesn't publish it; taken from the same model elsewhere (smallest known value)"> (from {PROVIDERS[m.context_from].label.split(" (")[0]})</span>}</dd></div>}
    {m.kind === "chat" && <div><dt>Tool calling</dt><dd>{yn(m.tool_calling)}</dd></div>}
    {m.kind === "chat" && <div><dt>Input types</dt><dd>{m.input_modalities?.join(", ") ?? "Unknown"}</dd></div>}
    {m.kind !== "chat" && <div><dt>Type</dt><dd>{KIND_LABELS[m.kind]}</dd></div>}
    {m.terms_url && <div><dt>Model terms</dt><dd><a href={m.terms_url} rel="noopener">{m.kind === "image" ? "Licence / commercial use" : "Licence"}</a></dd></div>}
    <div><dt>Rate limits</dt><dd>{formatLimits(m.limits)}{m.limit_scope === "shared" ? " (shared)" : ""}</dd></div>
    <div><dt>Usage terms</dt><dd>{m.usage_terms === "production-ok" ? "Production use allowed" : m.usage_terms === "evaluation-only" ? "Evaluation only" : "Unknown"}</dd></div>
    <div><dt>Data use</dt><dd>{m.data_logging === "logs-prompts" ? "Logs prompts" : m.data_logging === "may-train" ? "May use your prompts" : m.data_logging === "none-stated" ? "None stated" : "Unknown"}</dd></div>
    <div><dt>Account</dt><dd>{m.account_required === "no" ? "Not needed" : m.account_required === "yes" ? "Needed" : "Unknown"}</dd></div>
    <div><dt>Card required</dt><dd>{m.card_required === "yes" ? "Yes" : m.card_required === "no" ? "No" : "Unknown"}</dd></div>
    <div><dt>First seen</dt><dd>{formatDate(m.first_seen)}</dd></div>
  </dl>
  {m.limits?.note && <p class="sub">{m.limits.note}</p>}

  {(m.kind === "chat" || m.kind === "image") && (
    <>
      <h2>LMArena ratings</h2>
      {m.arena ? (
        <>
          <dl class="facts">
            {ARENA_BOARDS.filter((b) => m.arena!.boards[b]).map((b) => {
              const s = m.arena!.boards[b]!;
              return (
                <div>
                  <dt>{ARENA_BOARD_LABELS[b]}{b === "agent" ? " (rank only)" : ""}</dt>
                  <dd>{s.rating ? `${Math.round(s.rating)} · ` : ""}#{s.rank} of {s.of}</dd>
                </div>
              );
            })}
          </dl>
          <p class="sub">
            Listed on LMArena as <code>{m.arena.name}</code>{m.arena.published ? `, leaderboard of ${formatDate(m.arena.published)}` : ""}.
            Source: <a href={ARENA_DATASET_URL} rel="noopener">{ARENA_ATTRIBUTION}</a>. Ratings come from people comparing
            answers blind; they measure preference, not correctness.
          </p>
        </>
      ) : (
        <p class="sub">No LMArena rating yet. Many small or new free models aren't on its leaderboards.</p>
      )}
    </>
  )}

  {m.kind === "image" && (
    <>
      <h2>Sample outputs</h2>
      <p class="sub">The same three test prompts for every free image model; <a href="/image-models/">compare them all</a>.</p>
      <div class="offers">
        {SHOWCASE_PROMPTS.map((p) => {
          const img = showcase.images[showcaseKey(m.id, p.id)];
          return (
            <article class="offer sample">
              {img ? <a href={img.file}><img src={img.file} alt={`${m.name}: ${p.title}`} loading="lazy" width="768" height="768" /></a> : <div class="pending">Not made yet</div>}
              <h3>{p.title}</h3>
              <p class="sub">{p.look_for}</p>
            </article>
          );
        })}
      </div>
    </>
  )}

  <h2>Cost</h2>
  {m.pricing?.length ? (
    <>
      <p>
        <strong>Free</strong> within {provider.label}'s free allowance{allowanceNote(m.kind, m.pricing) ? `: ${allowanceNote(m.kind, m.pricing)}` : ""}.
        {costNote(m.kind, m.pricing) && <> Beyond it: <strong>{costNote(m.kind, m.pricing)}</strong> (needs the paid plan).</>}
      </p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Price beyond the free allowance</th><th class="num">Neurons</th></tr></thead>
          <tbody>
            {m.pricing.map((l) => <tr><td>{formatUsd(l.usd)} per {l.unit}</td><td class="num">{l.neurons ?? "–"}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="sub">Source: <a href="https://developers.cloudflare.com/workers-ai/platform/pricing/" rel="noopener">Cloudflare Workers AI pricing</a>. 10,000 Neurons are free every day; beyond that, $0.011 per 1,000 Neurons on the paid plan.</p>
    </>
  ) : (
    <p>
      <strong>{m.price_type === "trial-credit" ? "Free within a limited quota" : m.usage_terms === "evaluation-only" ? "Free for evaluation" : "$0"}</strong>
      {m.price_type !== "trial-credit" && " within the free tier"}{m.limits ? ` (${m.limit_scope === "shared" ? "limits shared across the provider's free models" : "limits per model"})` : ""}.
      {m.paid_version_pricing?.length ? (
        <> When you need more: the paid version of this model costs <strong>{m.paid_version_pricing.map((l) => `${formatUsd(l.usd)} per ${l.unit}`).join(", ")}</strong> on {provider.label.split(" (")[0]}.</>
      ) : (
        <span class="sub"> We don't track a paid price for this model.</span>
      )}
    </p>
  )}

  {!m.testable && (
    <p class="callout info">
      <strong>Only inside Cline.</strong> {provider.usage_terms_note}
      {siblings.length > 0 ? " Below you can see how the same model does at other providers." : " We don't track this model at another provider yet."}
    </p>
  )}

  {siblings.length > 0 && (
    <>
      <h2>Same model at other providers</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Provider</th><th>Last test</th>{m.kind === "chat" && <th class="num">Tool calls</th>}<th class="hide-sm">Labels</th></tr></thead>
          <tbody>
            {siblings.map((o) => {
              const t = toolStats(o.toolTests, RANKING_WINDOW_DAYS);
              return (
                <tr>
                  <td><a class="model-name" href={o.href}>{PROVIDERS[o.provider].label}</a><div class="sub mono">{o.model_id}</div></td>
                  <td class="nowrap"><TestStatus test={o.lastTest} untestable={!o.testable} /></td>
                  {m.kind === "chat" && <td class="num">{t.tested ? `${t.passed}/${t.tested}` : "–"}</td>}
                  <td class="hide-sm"><Badges m={o} /></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </>
  )}

  {m.testable && <h2>Daily test</h2>}
  {m.testable && <p><TestStatus test={m.lastTest} /></p>}
  {m.testable && m.tests.length > 0 && (
    <div class="history" aria-label="Test results, last 30 days">
      {m.tests.map((t) => <i class={`s-${t.status}`} title={`${formatTime(t.at)}: ${t.status}`}></i>)}
    </div>
  )}
  {m.testable && <p class="sub">
    {m.kind === "image" ? "One small image per week (image generation uses much more of a free allowance than chat)." : <>One short request per day{m.kind === "tts" ? ' (speak "OK")' : m.kind === "stt" ? " (transcribe an 18-second sample clip)" : ""}.</>}
    It shows the model answered at that moment, not that it is fast or available all day.
  </p>}

  {m.kind !== "chat" && (
    <>
      <h2>How to call it</h2>
      {geminiSpeech ? (
        <p>Gemini's speech models use Google's native API (<code>generateContent</code>), not the OpenAI-compatible one. See <a href={m.url} rel="noopener">Google's docs</a>.</p>
      ) : (
        <pre><code>{apiSnippet}</code></pre>
      )}
    </>
  )}

  {m.kind === "chat" && m.testable && <h2>Coding agents (Cline)</h2>}
  {m.kind === "chat" && m.testable && <p>
    {m.agent.level === "yes" && "Meets the agent-ready bar: tool calling, at least 64k context, and it answered on 5 of the last 7 test days."}
    {m.agent.level === "partial" && `Has tool calling and enough context, but: ${m.agent.reasons.join("; ")}.`}
    {m.agent.level === "no" && `Not suited to coding agents: ${m.agent.reasons.join("; ")}.`}
  </p>}
  {m.kind === "chat" && m.testable && (
    <p>
      <strong>Tool-call test:</strong> {tt.tested ? `passed on ${tt.passed} of ${tt.tested} days` : "not run yet"}.
      {" "}<strong>Cline:</strong>{" "}
      {fit.plan || fit.act ? (
        <>
          {fit.plan && <a href="/rankings/cline-plan/">#{fit.plan} for Plan mode</a>}
          {fit.plan && fit.act && " · "}
          {fit.act && <a href="/rankings/cline-act/">#{fit.act} for Act mode</a>}
          {" "}(<a href="/cline/">best pair</a>)
        </>
      ) : "not in the Plan or Act rankings yet"}.
    </p>
  )}
  {m.kind === "chat" && m.testable && <pre><code>{snippet}</code></pre>}
  {!m.testable && <pre><code>{`API Provider: Cline (sign in)\nModel:        pick "${m.name}" (tagged FREE)`}</code></pre>}

  <SponsorSlot />

  <h2>Change history</h2>
  <EventList events={history} empty={`No changes since we started tracking it on ${formatDate(m.first_seen)}.`} />

  <p class="sub"><a href={m.url} rel="noopener">Provider page for this model</a> · <a href={provider.limits_url} rel="noopener">{provider.label} limits</a></p>
</Base>
